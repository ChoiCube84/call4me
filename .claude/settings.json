      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(docker compose:*)",
      "Bash(xcodebuild:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
