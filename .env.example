# Copy to .env (never commit it). infra/deploy.sh reads this file and puts the
# secrets in Azure Key Vault; on Azure the app loads them from there.

# How calls are placed:
#   cartesia  a Cartesia agent dials the real number (needs PUBLIC_BASE_URL)
#   phone     fake support line; whoever opens /phone plays the rep
#   (empty)   mock with USE_MOCKS=true, else cartesia
TELEPHONY=cartesia
PUBLIC_BASE_URL=              # public https URL: the Azure URL, or a cloudflared tunnel in dev

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_AGENT_MODEL=claude-haiku-4.5   # GET https://api.cartesia.ai/v1/agents/models
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=            # or the Foundry settings below
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=

# Access token for the API. Empty = open (local dev). deploy.sh generates one for Azure.
API_TOKEN=

# sql keeps the existing installation. convex moves persistence to Convex.
STORAGE_BACKEND=sql
CONVEX_URL=                  # https://<deployment>.convex.cloud
CONVEX_BACKEND_TOKEN=        # same as Convex CALL4ME_BACKEND_TOKEN; never public
# In Convex, set CALL4ME_VIEWER_TOKEN equal to API_TOKEN (different from the worker token).
# Build web/ with NEXT_PUBLIC_CONVEX_URL set to the same public deployment URL.

DATABASE_URL=postgresql+asyncpg://call4me:call4me@localhost:5432/call4me
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=          # prod only: secrets are loaded from here when set
USE_MOCKS=false               # true: every service mocked, calls go to the in-process fake line

# Push (needs a paid Apple Developer account; leave empty on a free Apple ID)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=           # path to the .p8 key (or put its contents in APNS_AUTH_KEY)
APNS_AUTH_KEY=
APNS_USE_SANDBOX=true         # false for TestFlight / App Store builds
APNS_TOPIC=                   # app bundle id

# Optional: CALL4ME_CLAUDE_MODEL=claude-sonnet-5-5  CALL4ME_CLAUDE_EFFORT=low
