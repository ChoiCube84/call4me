TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AGENT_NUMBER=          # number the agent calls from / receives callbacks on
TWILIO_FAKELINE_NUMBER=       # its Voice webhook: <PUBLIC_BASE_URL>/fakeline/voice
USER_VERIFIED_CALLER_ID=      # optional: user's verified number for caller ID
PUBLIC_BASE_URL=              # ngrok URL in dev, Azure URL in prod
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=            # or Foundry settings below
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
DATABASE_URL=postgresql+asyncpg://call4me:call4me@localhost:5432/call4me
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=           # path to the .p8 key (or put its contents in APNS_AUTH_KEY)
APNS_AUTH_KEY=
APNS_USE_SANDBOX=true         # false for TestFlight / App Store builds
APNS_TOPIC=                   # app bundle id
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=          # prod only: secrets are loaded from here when set
USE_MOCKS=false               # true: every service mocked, calls go to the in-process fake line
# Optional: CALL4ME_CLAUDE_MODEL=claude-opus-5-5  CALL4ME_CLAUDE_EFFORT=low
