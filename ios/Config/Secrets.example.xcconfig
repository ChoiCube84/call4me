// call4me per-person build settings. Copy to Secrets.xcconfig (gitignored):
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// infra/deploy.sh writes CALL4ME_BACKEND_URL and CALL4ME_API_TOKEN for you and
// keeps the other lines. Run `xcodegen` again after editing this file.
//
// Gotcha: in .xcconfig files `//` starts a comment, so write URLs as
//   https:/$()/your-app.azurecontainerapps.io
// ($() expands to nothing and keeps the two slashes).

// Your Apple team id. Free Apple ID: Xcode > Settings > Accounts > your Personal Team;
// or leave empty and pick the team in Signing & Capabilities.
CALL4ME_TEAM_ID =

// A bundle id nobody else uses, e.g. com.yourname.call4me (the widget adds ".widget").
CALL4ME_BUNDLE_ID = com.example.call4me

// Backend address (the Azure URL printed by infra/deploy.sh).
CALL4ME_BACKEND_URL = http:/$()/localhost:8000

// Access code: the server's API_TOKEN. Can also be typed in the app's Settings.
CALL4ME_API_TOKEN =
